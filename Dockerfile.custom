FROM python:3.11-slim

ARG REPO_URL=https://github.com/tobias-weiss-ai-xr/litellm.git
ARG BRANCH=ce-size-limiting

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Clone the custom LiteLLM fork
RUN git clone --depth 1 --branch ${BRANCH} \
    ${REPO_URL} /app/litellm-src

WORKDIR /app/litellm-src

# Install LiteLLM with proxy extras and pin prisma
RUN pip install --no-cache-dir .[proxy] 'prisma==0.11.0' 'prometheus-client'

# Generate Prisma client
RUN prisma generate

ENTRYPOINT ["litellm"]
